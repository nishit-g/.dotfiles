# Machine-specific git config (not tracked in git)
# Copy to ~/.gitconfig.local and customize

[user]
    name = Your Name
    email = your.email@example.com
    signingkey = ~/.ssh/id_ed25519.pub

[commit]
    gpgsign = true

[gpg]
    format = ssh

# Work-specific overrides
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig.work
