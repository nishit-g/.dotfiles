# Machine-specific SSH hosts (not tracked in git)
# Copy to ~/.ssh/config.local and customize

Host mac-home
    HostName 100.x.x.x
    User your-username
    Port 22

Host android
    HostName 100.x.x.x
    User u0_a123
    Port 8022

Host work-server
    HostName your-work-server.com
    User your-username
    IdentityFile ~/.ssh/work_key
