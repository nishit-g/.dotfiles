#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------------
# Ultra-fast tmux sessionizer (top-level only)
# --------------------------------------------------------
# - Only lists DIRECT subdirectories of your project roots
# - No deep recursion, no marker scanning
# - Cached project list for speed
# - "Recent" section + fzf picker
# - Smart tmux attach/create behavior
# --------------------------------------------------------

# ---- CONFIG -------------------------------------------------

PROJECT_DIRS=(
  "$HOME/personal"
)

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-sessionizer"
CACHE_FILE="${CACHE_DIR}/projects.txt"
RECENT_FILE="${CACHE_DIR}/recent.txt"

FZF_BIN="${FZF_BIN:-fzf}"

CACHE_MAX_AGE_MINUTES=10      # Rebuild cache if older than this
MAX_RECENT=50                 # How many recent dirs to keep

mkdir -p "$CACHE_DIR"
touch "$RECENT_FILE"

# ---- UTILS --------------------------------------------------

exists() {
  command -v "$1" >/dev/null 2>&1
}

now_epoch() {
  date +%s
}

file_age_minutes() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    echo 999999
    return
  fi

  local now ts
  now=$(now_epoch)
  ts=$(stat -f "%m" "$file" 2>/dev/null || stat -c "%Y" "$file")
  echo $(((now - ts) / 60))
}

# ---- PROJECT DISCOVERY (TOP-LEVEL ONLY) ---------------------

build_project_list() {
  : > "${CACHE_FILE}.tmp"

  local dir
  for dir in "${PROJECT_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue

    # Only direct children: mindepth=1, maxdepth=1
    find "$dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null >> "${CACHE_FILE}.tmp"
  done

  sort -u "${CACHE_FILE}.tmp" > "$CACHE_FILE"
  rm -f "${CACHE_FILE}.tmp"
}

ensure_cache_fresh() {
  local age
  age=$(file_age_minutes "$CACHE_FILE")
  if (( age > CACHE_MAX_AGE_MINUTES )); then
    build_project_list
  fi
}

# ---- RECENT PROJECTS ----------------------------------------

bump_recent() {
  local dir="$1"
  { echo "$dir"; cat "$RECENT_FILE"; } \
    | awk '!seen[$0]++' \
    | head -n "$MAX_RECENT" \
    > "${RECENT_FILE}.tmp"
  mv "${RECENT_FILE}.tmp" "$RECENT_FILE"
}

recent_block() {
  if [[ -s "$RECENT_FILE" ]]; then
    echo ":: Recent"
    cat "$RECENT_FILE"
    echo
  fi
}

# ---- FZF SELECTION ------------------------------------------

pick_project() {
  local preselect="${1:-}"

  ensure_cache_fresh

  if [[ ! -s "$CACHE_FILE" ]]; then
    echo "No projects found. Edit PROJECT_DIRS in tmux-sessionizer." >&2
    exit 1
  fi

  if ! exists "$FZF_BIN"; then
    cat "$CACHE_FILE"
    exit 0
  fi

  local input
  input="$(
    {
      recent_block
      echo ":: All"
      cat "$CACHE_FILE"
    } | awk 'NF'
  )"

  local selected
  if [[ -n "$preselect" ]]; then
    selected=$(echo "$input" | "$FZF_BIN" \
      --no-sort \
      --prompt="session> " \
      --header="Enter to open • Ctrl-C to cancel" \
      --query="$preselect")
  else
    selected=$(echo "$input" | "$FZF_BIN" \
      --no-sort \
      --prompt="session> " \
      --header="Enter to open • Ctrl-C to cancel")
  fi

  # If they picked a header or nothing
  if [[ -z "$selected" || "$selected" == ::* ]]; then
    echo ""
    return
  fi

  echo "$selected"
}

# ---- TMUX INTEGRATION ---------------------------------------

session_name_from_path() {
  local path="$1"
  local base
  base=$(basename "$path")
  echo "$base" \
    | tr ' ' '_' \
    | tr '.' '_' \
    | tr '[:upper:]' '[:lower:]'
}

attach_or_create_session() {
  local dir="$1"
  local session_name
  session_name=$(session_name_from_path "$dir")

  local tmux_running
  tmux_running=$(pgrep -x tmux || true)

  if [[ -z "${TMUX:-}" ]] && [[ -z "$tmux_running" ]]; then
    exec tmux new-session -s "$session_name" -c "$dir"
  fi

  if ! tmux has-session -t="$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$dir"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session_name"
  else
    tmux attach-session -t "$session_name"
  fi
}

# ---- MAIN ---------------------------------------------------

main() {
  local selected=""
  local arg="${1:-}"

  if [[ -n "$arg" ]]; then
    if [[ -d "$arg" ]]; then
      selected="$arg"
    else
      selected=$(pick_project "$arg")
    fi
  else
    selected=$(pick_project)
  fi

  if [[ -z "$selected" ]]; then
    exit 0
  fi

  bump_recent "$selected"
  attach_or_create_session "$selected"
}

main "$@"
